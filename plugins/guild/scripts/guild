#!/usr/bin/env bash
#
# guild — deterministic CLI for the Guild plugin's board.
#
# v5: the board is a Turso database, not a directory tree. Status is a COLUMN, IDs are
# derived in SQL (`MAX(n) + 1`, in the same statement as the insert), and the cursor is
# still derived (the in-progress task). Two storage modes, chosen at `guild init`:
#
#   local  .guild/guild.db          via `tursodb -q -m list`   (default, no account)
#   cloud  $TURSO_DATABASE_URL      via `turso db shell`       (opt-in)
#
# What git carries: .guild/config.yaml, .guild/journal.ndjson, .guild/export/.
# What it does not: .guild/guild.db (derived state; `guild rebuild` replays it).
#
# This file is the DISPATCHER ONLY. Every command lives in a cmd_* function in one of
# the modules under lib/, which define functions and nothing else:
#
#   lib/db.sh         driver, config, SQL literals, JSON escaping, the spool
#   lib/journal.sh    the append-only change log: append, preflight, recover, sync,
#                     rebuild, compact
#   lib/artifacts.sh  new / read / meta / status / move / retitle / list / next /
#                     batch / slice / plan slice(s) / next-id / log / finding /
#                     spool drain / checkin
#   lib/render.sh     board, export (markdown + JSON)
#   lib/init.sh       init, v4 archival, docs/qa carry-over, the journal wrappers
#   lib/direction.sh  goal / phase / req assign — the layer above requirements (Stage 2)
#   lib/records.sh    bug / doc — defects and the evergreen knowledge base (Stage 2)
#   lib/quality.sh    coverage — the quality areas the QA discipline maps and inspects
#   lib/brief.sh      brief — the structured briefing behind the guild:brief skill
#   lib/dashboard.sh  dashboard — the seven-view self-contained HTML page
#   lib/roster.sh     sync-agents / match / bounties / capability-request(s) — the roster,
#                     the deterministic matcher and recruiting (Stage 3)
#   lib/graph.sh      graph new / graph <REQ> [--explain] / graph validate / graph deviate —
#                     the execution graph, instantiated from a template (Stage 4). It also
#                     owns THE ONE YAML SCANNER; nothing else in the CLI parses YAML.
#   lib/template.sh   templates / template — the templates as a readable surface, projected
#                     from lib/graph.sh's scanner into the flat form lib/segment.sh reads
#   lib/segment.sh    segment / node / gate / gates — the runnable batches between gates, the
#                     work-node writer that makes readiness propagate, and the two-decision
#                     control surface the guild master owns (Stage 4)
#   lib/shift.sh      shift — the unattended loop's CONTROLLER: which requirement, and
#                     whether to keep going. Run until the next gate, then stop (Stage 5)
#   lib/gitsafe.sh    git branch-for / commit-task / revert-task / shift-status — the only
#                     git a shift may do: its own branch, one commit per completed task,
#                     never a push and never the default branch (Stage 5)
#   lib/report.sh     shift-report — what happened while you were away, reconstructed from
#                     the `event` log. `brief` says where the project STANDS; this says what
#                     MOVED, what failed, what is blocked, which gates wait, and why it
#                     stopped (Stage 5)
#
# THE CHAIN IS DATA NOW. Through Stage 3 the order of work was compiled into the skills:
# check-in knew review follows test-write. In v5 it is `templates/*.yaml` instantiated into
# `graph_node` / `graph_edge` / `gate` rows, and `guild segment` is what says what runs next.
# `guild next` and `guild batch` survive as the v4 cursor for boards with no graph.
#
# THERE IS NO `guild path`. In v4 the path WAS the storage, so an agent could resolve a
# path and Edit it. In v5 only requirements get an export file, that file is generated
# output, and `guild export` rebuilds the whole directory on every run — so a returned
# path was a place where an agent's work went to be silently discarded. Reads go through
# `guild read` / `guild meta` / `guild slice`; writes go through `guild log`,
# `guild finding`, `guild retitle`, `guild move`, `guild checkin`.
#
# Usage: guild <command> [args]   —   run `guild help` for the full list.

set -euo pipefail

# ---- locate ourselves ------------------------------------------------------------
#
# Skills invoke this as ${CLAUDE_PLUGIN_ROOT}/scripts/guild from an arbitrary cwd, and
# a user may well have symlinked it onto $PATH. Resolve the symlink chain by hand:
# macOS has no `readlink -f`, and `realpath` is not guaranteed either.

_guild_self="${BASH_SOURCE[0]:-$0}"
while [ -L "$_guild_self" ]; do
  _guild_dir="$(cd -P "$(dirname "$_guild_self")" && pwd)"
  _guild_self="$(readlink "$_guild_self")"
  case "$_guild_self" in
    /*) ;;
    *) _guild_self="$_guild_dir/$_guild_self" ;;
  esac
done
GUILD_SCRIPT_DIR="$(cd -P "$(dirname "$_guild_self")" && pwd)"
unset _guild_self _guild_dir

GUILD_LIB_DIR="$GUILD_SCRIPT_DIR/lib"
for _guild_mod in db journal artifacts render init direction records brief quality dashboard roster graph template segment shift gitsafe report; do
  if [ ! -f "$GUILD_LIB_DIR/$_guild_mod.sh" ]; then
    printf 'guild: missing module %s/%s.sh — is the plugin checkout complete?\n' \
      "$GUILD_LIB_DIR" "$_guild_mod" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  . "$GUILD_LIB_DIR/$_guild_mod.sh"
done
unset _guild_mod

# ---- retired v4 commands ---------------------------------------------------------
#
# v5 has no flat-file legacy format and no history import (§4, §11): a v4 board is
# ARCHIVED to .guild/v4-archive/ by `guild init`, never parsed.
#
# `is-legacy` keeps working as a predicate rather than erroring, because the v4 skills
# call it as `if "$GUILD" is-legacy; then "$GUILD" migrate; fi` — answering "no" is
# both true and the safe branch. `migrate` says plainly what replaced it.

cmd_is_legacy() {
  return 1
}

cmd_migrate() {
  die "guild: 'migrate' was retired in v5 — there is no history import.
'guild init' MOVES an existing v4 board to .guild/v4-archive/ (untouched, still in
git) and carries over only .guild/docs/ and .guild/qa/. Re-enter unfinished work with
the guild:new-requirement skill, reading the archived plan for the details."
}

# ---- help ------------------------------------------------------------------------

cmd_help() {
  cat <<'EOF'
guild — deterministic CLI for the Guild board (a Turso database; status is a column).

Setup:
  guild init [--mode local] [--url-env NAME] [--token-env NAME] [--yes] [DATE]
                                 Create config.yaml, schema, journal, spool/, export/,
                                 docs/, qa/, reviews/; archive an existing v4 board
                                 (moved, never deleted); carry over docs/ + qa/; seed the
                                 roster from agents/*.md (never fatal — the summary says
                                 so, and `guild sync-agents` is the retry).
                                 Cloud mode is NOT yet verified and is refused.

Direction (goals and phases sit ABOVE requirements; a requirement's phase is optional):
  guild goal new   --title T [--body B] [--priority 1-5] [--date YYYY-MM-DD]
  guild goal list  [status]     "<GOAL-ID> <status> <priority> <done>/<total> <title>"
  guild goal show  <GOAL-ID>    The goal, its phases, and their requirements
  guild goal move  <GOAL-ID> <status>       todo|in-progress|done
  guild goal priority <GOAL-ID> <1-5>       1 highest .. 5 lowest
  guild goal rollup [GOAL-ID]   Recompute goal and phase status from the requirements
                                beneath: a phase is done when every requirement in it is,
                                a goal is done when every phase is, in-progress when any
                                child has started. Childless rows are left alone (a human
                                set those). Idempotent; prints one "<ID> from -> to" line
                                per change and nothing when nothing moved.
  guild phase new  --goal GOAL-NNN --title T [--ordinal N] [--date YYYY-MM-DD]
  guild phase list [--goal GOAL-NNN]
  guild phase move <PHASE-ID> <status>      todo|in-progress|done
  guild req assign <REQ-NNN> <PHASE-NNN|none>   Attach a requirement to a phase (or detach)

Create (templates, IDs derived in SQL) — each prints the new ID:
  guild new req  --title T [--desc D | --body B] [--date YYYY-MM-DD]
  guild new task --title T --req REQ-NNN (--agent A | --needs cap,cap) [--prefers cap,cap]
                 [--plan PLAN-NNN] [--plan-slice slug]
                 [--parallel-group LABEL] [--objective O | --body B] [--date YYYY-MM-DD]
      --agent pins a member; --needs describes the WORK and lets the roster answer
      ('guild match'). Both together pin AND record what the work needed. One is required.
  guild new plan --title T --req REQ-NNN [--desc D | --body B] [--task TASK-NNN]
                 [--date YYYY-MM-DD]
      --desc / --objective fill one section of the template; --body REPLACES it, and is
      how a product-owner or architect authors a whole document now that there is no file.

Plan slices (the architect's units of parallel implementation work — `fanout: per-slice`
dispatches one implementation node per slice, so a plan with no slices fans out to one):
  guild plan slice  <PLAN-NNN> --slug SLUG --title T [--body B | --file F]
                    [--files "a,b,c"]
      Upsert one slice; prints "PLAN-NNN/slug". --files is the DISJOINT-FILE ASSERTION:
      the files this slice touches and no sibling does, which is what makes concurrent
      dispatch reviewable. Omitted --body/--files preserve what is stored; --files ''
      clears the set. The brief is read back with `guild slice <PLAN-NNN> <slug>`.
  guild plan slices <PLAN-NNN> [--files]
      "<slug> <title>", or with --files "<slug> <json-array-of-files>"

Read (the v4 `path` command is REMOVED — nothing hands out a writable path now):
  guild read  <ID>              Render the artifact as markdown, from the database
  guild meta  <ID> [field]      Print the frontmatter (or one field) — cheaper than read
  guild status <ID>             Print the artifact's status
  guild slice <PLAN-ID> <slug>  Print a plan slice's body
  guild next-id <req|task|plan> Print the next available ID number (NNN)

Orchestrator writes (agents never move their own work):
  guild move    <ID> <status>   Set status to todo|in-progress|done|failed — and for a
                                TASK also `blocked`, which means no guild member can take
                                the bounty. `blocked` counts as OPEN for requirement
                                completion (so nothing closes over un-attempted work) and
                                `blocked -> done` is refused.
  guild retitle <ID> "New title"
  guild checkin [YYYY-MM-DD]    Record today's check-in (default: today, UTC)

Agent writes — one appended line, no database connection (§2.4):
  guild log     <TASK-ID> --agent A --entry "what you did"
  guild finding <TASK-ID> --reviewer R --severity critical|major|minor|nit
                          --summary S [--detail D] [--file F] [--line N]
  guild spool drain <TASK-ID>   Orchestrator: fold a task's spool into the database

Defects (first-class records, not prose in a work log):
  guild bug new   --title T [--body B] [--repro R] [--severity critical|major|minor]
                  [--req REQ-NNN] [--found-by WHO] [--date YYYY-MM-DD]
  guild bug list  [open|fixing|fixed|wontfix] [--severity critical|major|minor]
  guild bug show  <BUG-ID>      Render the bug as markdown
  guild bug fix   <BUG-ID> --task TASK-NNN   Link the fix task; moves the bug to `fixing`
  guild bug close <BUG-ID> [--wontfix]       Close as `fixed`, or as `wontfix`

Quality areas (what the product is made of, from a quality standpoint; `last_inspected_at`
is what makes "what has nobody looked at" a query — the QA discipline writes these):
  guild coverage set <area-id> --area T [--risk high|medium|low] [--spec PATH]
                  [--notes N]   Upsert; preserves anything not passed, never the clock
  guild coverage inspect <area-id> [--date YYYY-MM-DD]   Stamp last_inspected_at
  guild coverage list [--risk high|medium|low] [--due]
                                "<area-id> <risk> <last-inspected|never> <spec|none> <area>"
  guild coverage show <area-id> Render the area as markdown

Knowledge base (evergreen — survives releases and board resets; the architect reads it):
  guild doc put   <slug> --title T [--body B | --file F] [--source S]   Upsert; prints the slug
  guild doc get   <slug>        Print the body VERBATIM (round-trips byte for byte)
  guild doc list                "<slug> <updated> <title>"
  guild doc search <query>      Case-insensitive substring search over title and body

The roster (a task names a CAPABILITY; any member whose capabilities cover it is eligible.
A task that declares none still matches its own --agent, so every existing board is
unaffected. `guild init` seeds the roster; this is how you refresh it):
  guild sync-agents [--dry-run]  Scan agents/*.md frontmatter into the roster. Idempotent:
                                 new members added, removed members DEACTIVATED (never
                                 deleted — a finished task may name one), capability sets
                                 replaced. $GUILD_AGENTS_DIR overrides where it looks.
  guild match <TASK-ID> [--json] The ranked eligible members: preferred covered (desc),
                                 then total capabilities (asc, so a specialist beats a
                                 generalist), then name. Rank 1 is the dispatch target.
                                 Exits 1 and names the missing capabilities when nobody
                                 is eligible — that is a roster gap, and it is loud.
  guild bounties [--json]        Open, dependency-satisfied tasks with their matched
                                 member, then everything that CANNOT be worked and why
                                 (status-blocked, deps:<ids>, no-eligible-agent:<caps>).
  guild capability-request <capability> --req REQ-NNN --rationale "..." --proposes NAME
                          [--spec "..."]
                                 File a roster gap. Surfaces in `guild brief` -> Roster
                                 Gaps, and admits the capability to the vocabulary so the
                                 new agent file syncs.
  guild capability-requests [--open]
                                 "<id> <status> <capability> <req> <proposed-agent> <why>"

The execution graph (the chain is DATA — a template instantiated per requirement, deviated
from only with a recorded reason. Two gates, always: gate-plan before anything is built,
gate-repairs after review. A gate may never be added and never dropped):
  guild templates               "<name> <source>" — what exists, and whether the file that
                                wins is the project's or the plugin's
  guild template <name> [<node-key> <field>]
                                The whole template as one fact per line, or ONE field
                                byte-exact. Fields: key kind prompt kind_detail required
                                needs after fanout parallel agents
  guild graph new <REQ-NNN> [--template standard|maintenance]
                                Instantiate the graph. Refuses a second run — every node,
                                edge, gate row, the template record and the event are ONE
                                script, so a repeat would duplicate or silently discard the
                                deviations already recorded. Run it AFTER the plan slices
                                and the tickets exist: nodes bind to them at instantiation.
  guild graph <REQ-NNN> [--explain]
                                Render the graph; --explain diffs TEMPLATE vs ACTUAL side by
                                side with every deviation's reason
  guild graph validate <REQ-NNN>
                                The deviation rules, against what is STORED (rows also
                                arrive by journal replay). Exit 0 and one line, or exit 1
                                listing every FAIL: no-graph, unknown-template, empty-reason,
                                unknown-kind, added-gate, dropped-gate, dropped-required,
                                dropped-node-no-reason, added-node-no-reason,
                                unknown-capability, uncapable-add-node,
                                cross-requirement-edge, self-edge
  guild graph deviate <REQ-NNN> --kind add-node|drop-node|reshape --node KEY
                                --reason "..." [--needs cap,cap] [--prefers cap,cap]
                                [--after KEY,KEY] [--title T] [--parallel-group G]
                                add-node REQUIRES --needs, and every named capability must
                                be declared by an ACTIVE member. drop-node stitches the
                                dropped node's predecessors to its successors. --kind
                                add-gate is REFUSED, always. An empty reason is refused.
  guild segment <REQ-NNN> [--json]
                                The next gate-free run of node batches, in order, each
                                marked parallel or sequential, with the member each node
                                dispatches to and the gate the segment ends at. Reads only.
                                --json is what an orchestrator compiles into a workflow.
                                REFUSES (exit 1) to emit a parallel batch holding two
                                `serial` members rather than silently serializing them.
  guild node <NODE-ID> <status> [--task TASK-NNN]
                                Move a WORK node: pending|ready|running|done|failed|skipped.
                                THIS IS WHAT MAKES READINESS PROPAGATE — a node is ready when
                                every DIRECT predecessor is done or skipped, so nothing behind
                                a batch opens until its nodes are moved. `--task` binds the
                                ticket the orchestrator dispatched, for the nodes `graph new`
                                could not bind unambiguously. A GATE is refused: its status is
                                a decision, and `guild gate` is where one is recorded.
  guild gate <NODE-ID> --approve|--reject [--decision "..."]
                                Record the guild master's decision. Approval sets the gate
                                node `done`, which is what unblocks its successors; rejection
                                sets it `failed`, which holds them. Refused when the gate is
                                not ready, when it is already approved, or when a
                                select-findings gate is approved with no --decision
                                (`--decision none` is how you approve and repair nothing).
  guild gates [--pending] [--json]
                                "<node> <req> <status> <kind> <ready|waiting> <prompt>" —
                                every gate board-wide. The readiness column is the point:
                                a pending gate whose predecessors are still running is
                                awaiting the GUILD, not the guild master.

Unattended operation (design 8 — RUN UNTIL THE NEXT GATE, THEN STOP AND NOTIFY. The segment
boundary and the stop boundary are the same line, so a shift needs no separate notion of how
far it may go. It may claim bounties, run segments, retry once, fail, block and file; it may
NEVER decide a gate, proceed past one, delete, push, or commit to the default branch):
  guild shift [--max-tasks N] [--max-minutes M] [--requirement REQ-NNN] [--dry-run] [--json]
                                ONE TURN of the loop, answering WHAT NOW with `run` (this
                                requirement is actionable — read `guild segment REQ --json`,
                                dispatch its first batch, call this again) or `stop` (with
                                the reason, written to `event`). It does NOT re-emit the
                                batches: the shift decides WHICH requirement and WHETHER TO
                                CONTINUE, `guild segment` decides WHAT RUNS. Budgets default
                                to 10 tasks / 60 minutes and are FIXED when the shift opens —
                                passing the same values every turn is fine, changing them
                                mid-shift is refused.
  guild shift --end [--reason R] [--note "..."]
                                Close the open shift. R is gate | infrastructure | max-tasks
                                | max-minutes | idle | collision | operator; the last two are
                                the ones only the orchestrator can see.
  guild shift --policy [--json] The may / may-not table in full — the contract an unattended
                                run operates under. Touches no database.
  guild shift-report [--since YYYY-MM-DD] [--json]
                                WHAT HAPPENED WHILE YOU WERE AWAY, reconstructed from the
                                `event` log: the shifts and their outcomes, what they
                                finished, what failed and was retried, what is blocked, the
                                gates waiting on you, what was filed and committed, and why
                                it stopped. The window defaults to where the LAST SHIFT
                                began. `guild brief` says where the project STANDS; this says
                                what MOVED. Reads only, writes nothing.
  guild git branch-for <REQ-NNN> [--from REF]
  guild git commit-task <TASK-NNN> [--path P]... [--all]
                                   [--type T] [--scope S] [--subject S] [--dry-run]
  guild git revert-task <TASK-NNN> [--dry-run]
  guild git shift-status
                                The only git a shift may do (8.6): its own `guild/REQ-NNN`
                                branch, ONE COMMIT PER COMPLETED TASK with the task id in the
                                trailer, a recoverable revert of a FAILED task's partial
                                edits (quarantined, never deleted), and a read-only account
                                of what it did to the tree. Every git call goes through one
                                ALLOWLIST: push, fetch, pull, remote, merge, rebase, reset,
                                cherry-pick, clean and tag are not on it, and committing to
                                the default branch is refused. `guild git help` for the full
                                surface.

Query:
  guild list <req|task|plan> [status]   List "<ID> <status>" lines (tasks add "<agent> <req>"
                                        columns — filter with awk, e.g. $3=="reviewer" && $4=="REQ-001")
  guild next                            Print the next actionable "<TASK-ID>" or "none"
  guild batch <TASK-ID>                 Print the dev tickets that dispatch together (parallel-group)
  guild board                           Render the live board
  guild brief [--since YYYY-MM-DD] [--json]
                                        The structured briefing: direction, what is in flight,
                                        what is blocked, open bounties, bugs, coverage due, and
                                        what moved since the last check-in. Reads only.
  guild dashboard [--open] [--out PATH] [--json]
                                        Write a self-contained .guild/dashboard.html —
                                        roadmap, board, graph, bugs, findings, coverage, activity.
                                        No server, no network, works offline.

Durability:
  guild export [--json]         Regenerate .guild/export/*.md, or dump state as JSON
  guild rebuild                 Replay .guild/journal.ndjson into a fresh database
  guild journal compact [--force]  Snapshot current state as a new baseline journal
  guild journal recover         Fold .guild/journal.pending back into the journal
  guild journal sync [table...] Journal un-journaled work_log/review_finding/event rows

Environment:
  GUILD_DIR             Guild root directory (default: .guild)
  GUILD_ACTOR           Who mutations are attributed to (default: orchestrator)
  GUILD_SCHEMA          Override the path to schema.sql
  GUILD_AGENTS_DIR      Where `sync-agents` reads agent definitions (default:
                        $CLAUDE_PLUGIN_ROOT/agents, then the checkout's own agents/)
  GUILD_TEMPLATES_DIR   Searched BEFORE .guild/templates/ and the plugin's templates/
  GUILD_ASSUME_YES      Skip `init`'s v4-archival prompt

Storage needs the TursoDB engine shell (local mode, the default and the only verified one):
  tursodb   curl --proto '=https' --tlsv1.2 -LsSf \
              https://github.com/tursodatabase/turso/releases/latest/download/turso_cli-installer.sh | sh
EOF
}

# ---- dispatch --------------------------------------------------------------------
#
# `init` runs BEFORE db_load_config: it is the command that creates config.yaml, and it
# seeds the driver globals itself so the binary check reports the mode being written
# rather than a default read back from a file that does not exist yet.

main() {
  local cmd
  [ $# -ge 1 ] || { cmd_help; return 1; }
  cmd="$1"
  shift

  case "$cmd" in
    help | -h | --help)
      cmd_help
      return 0
      ;;
    init)
      cmd_init "$@"
      return 0
      ;;
  esac

  db_load_config

  case "$cmd" in
    goal)      cmd_goal "$@" ;;
    phase)     cmd_phase "$@" ;;
    req)       cmd_req "$@" ;;
    plan)      cmd_plan "$@" ;;
    bug)       cmd_bug "$@" ;;
    coverage)  cmd_coverage "$@" ;;
    doc)       cmd_doc "$@" ;;
    new)       cmd_new "$@" ;;
    read)      cmd_read "$@" ;;
    meta)      cmd_meta "$@" ;;
    status)    cmd_status "$@" ;;
    slice)     cmd_slice "$@" ;;
    next-id)   cmd_next_id "$@" ;;
    move)      cmd_move "$@" ;;
    retitle)   cmd_retitle "$@" ;;
    checkin)   cmd_checkin "$@" ;;
    log)       cmd_log "$@" ;;
    finding)   cmd_finding "$@" ;;
    spool)     cmd_spool "$@" ;;
    list)      cmd_list "$@" ;;
    next)      cmd_next "$@" ;;
    batch)     cmd_batch "$@" ;;
    sync-agents)         cmd_sync_agents "$@" ;;
    match)               cmd_match "$@" ;;
    bounties)            cmd_bounties "$@" ;;
    capability-request)  cmd_capability_request "$@" ;;
    capability-requests) cmd_capability_requests "$@" ;;
    templates) cmd_templates "$@" ;;
    template)  cmd_template "$@" ;;
    graph)     cmd_graph "$@" ;;
    segment)   cmd_segment "$@" ;;
    node)      cmd_node "$@" ;;
    gate)      cmd_gate "$@" ;;
    gates)     cmd_gates "$@" ;;
    shift)        cmd_shift "$@" ;;
    shift-report) cmd_shift_report "$@" ;;
    git)          cmd_git "$@" ;;
    board)     cmd_board "$@" ;;
    brief)     cmd_brief "$@" ;;
    dashboard) cmd_dashboard "$@" ;;
    export)    cmd_export "$@" ;;
    rebuild)   cmd_rebuild "$@" ;;
    journal)   cmd_journal "$@" ;;
    is-legacy) cmd_is_legacy "$@" ;;
    migrate)   cmd_migrate "$@" ;;
    path)
      # Removed, not renamed — and it must say so, because thirteen v4 call sites used
      # to Edit the file it named. A bare "unknown command" would read as a typo.
      die "guild: 'path' was removed in v5 — there is no writable file behind an ID.

In v4 the path WAS the storage. In v5 the board is a database; only requirements get an
export file, and 'guild export' regenerates that whole directory, so anything Edited
there is discarded on the next export.

  read it       guild read <ID>            (the rendered document)
                guild meta <ID> [field]    (just the frontmatter)
                guild slice <PLAN-ID> <slug>
  write it      guild log <TASK-ID> --agent A --entry '...'
                guild finding <TASK-ID> --reviewer R --severity S --summary '...'
                guild retitle <ID> 'New title'
                guild move <ID> <status>"
      ;;
    *)
      printf "guild: unknown command '%s' (try 'guild help')\n" "$cmd" >&2
      return 1
      ;;
  esac
}

main "$@"
